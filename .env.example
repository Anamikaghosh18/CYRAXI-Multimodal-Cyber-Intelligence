# CYRAXI Platform Central Configuration Template
# Copy this file to .env and configure for local or staging environments.

# Environment
CYRAXI_ENV=development
LOG_LEVEL=INFO

# Dataset Storage Paths
# Path to the primary Phishpedia archive (ZIP file) or extracted directory
PHISHPEDIA_DATA_DIR=data
PHISHPEDIA_ARCHIVE_PATH=data/phish_sample_30k.zip
MANIFEST_OUTPUT_PATH=data/phishpedia_manifest.jsonl

# Modality Feature Toggles (Enable/disable modules per node)
ENABLE_URL_ANALYZER=true
ENABLE_HTML_ANALYZER=true
ENABLE_OCR_EXTRACTOR=true
ENABLE_CV_DETECTOR=true
ENABLE_FUSION_ENGINE=true
ENABLE_NEO4J_INGESTION=true

# Execution Hardware ('cpu', 'cuda', 'mps')
PREFERRED_DEVICE=cpu

# Fusion Engine Weights Configuration File
FUSION_WEIGHTS_CONFIG=configs/fusion_weights.yaml

# Neo4j Graph Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cyraxi_secret_password
NEO4J_DATABASE=neo4j
